// SYMBOLIC CONNECTIVITY ONLY: supply authorized process models separately.
// 8-bit SAR logic: real-model MOS only; no ideal logic sources
// Width/length units passed to the MOS callback are metres.
// All subcircuits have vdd vss as their first two ports.
// RST: active high. Ring initialization: q0=1, q1..q9=0.
// Slot order: q0,q1 track; q2..q9 decide bits 7..0.
// Output D7..D0 updates one slot after the final decision.

subckt sar_inv vdd vss a y
Mp (y a vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mn (y a vss vss) NMOS_CORE w=5e-07 l=3e-08
ends sar_inv

subckt sar_inv_hi vdd vss a y
Mp (y a vdd vdd) PMOS_CORE w=3e-06 l=3e-08
Mn (y a vss vss) NMOS_CORE w=2e-06 l=3e-08
ends sar_inv_hi

subckt sar_nand2 vdd vss a b y
Mp0 (y a vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mp1 (y b vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mn0 (y a ns vss) NMOS_CORE w=1e-06 l=3e-08
Mn1 (ns b vss vss) NMOS_CORE w=1e-06 l=3e-08
ends sar_nand2

subckt sar_nor2 vdd vss a b y
Mp0 (ps a vdd vdd) PMOS_CORE w=2e-06 l=3e-08
Mp1 (y b ps vdd) PMOS_CORE w=2e-06 l=3e-08
Mn0 (y a vss vss) NMOS_CORE w=5e-07 l=3e-08
Mn1 (y b vss vss) NMOS_CORE w=5e-07 l=3e-08
ends sar_nor2

subckt sar_and2 vdd vss a b y
Xn (vdd vss a b yn) sar_nand2
Xi (vdd vss yn y) sar_inv
ends sar_and2

subckt sar_or2 vdd vss a b y
Xn (vdd vss a b yn) sar_nor2
Xi (vdd vss yn y) sar_inv
ends sar_or2

subckt sar_tg vdd vss a y en enb
Mn (y en a vss) NMOS_CORE w=5e-07 l=3e-08
Mp (y enb a vdd) PMOS_CORE w=1e-06 l=3e-08
ends sar_tg

subckt sar_mux vdd vss d0 d1 sel y
Xs (vdd vss sel selb) sar_inv
Xt0 (vdd vss d0 y selb sel) sar_tg
Xt1 (vdd vss d1 y sel selb) sar_tg
ends sar_mux

subckt sar_buf_hi vdd vss a y
Xi0 (vdd vss a an) sar_inv
Xi1 (vdd vss an y) sar_inv_hi
ends sar_buf_hi

subckt sar_phases vdd vss clk phm phmb phs phsb
Xci (vdd vss clk clkb) sar_inv
Xmn (vdd vss clkb phs mraw) sar_nor2
Xsn (vdd vss clk phm sraw) sar_nor2
Xmb (vdd vss mraw phm) sar_buf_hi
Xsb (vdd vss sraw phs) sar_buf_hi
Xmi (vdd vss phm phmb) sar_inv_hi
Xsi (vdd vss phs phsb) sar_inv_hi
ends sar_phases

subckt sar_latchr0 vdd vss d en enb rst nrst q
Xin (vdd vss d x en enb) sar_tg
Xfb (vdd vss q x enb en) sar_tg
Xg (vdd vss x nrst qb) sar_nand2
Xo (vdd vss qb q) sar_inv
ends sar_latchr0

subckt sar_pdffr0 vdd vss d phm phmb phs phsb rst nrst q
Xmaster (vdd vss d phm phmb rst nrst mq) sar_latchr0
Xslave (vdd vss mq phs phsb rst nrst q) sar_latchr0
ends sar_pdffr0

subckt sar_dffr0 vdd vss d clk rst q
Xri (vdd vss rst nrst) sar_inv
Xph (vdd vss clk phm phmb phs phsb) sar_phases
Xff (vdd vss d phm phmb phs phsb rst nrst q) sar_pdffr0
ends sar_dffr0

subckt sar_latchr1 vdd vss d en enb rst nrst q
Xin (vdd vss d x en enb) sar_tg
Xfb (vdd vss q x enb en) sar_tg
Xg (vdd vss x rst qb) sar_nor2
Xo (vdd vss qb q) sar_inv
ends sar_latchr1

subckt sar_pdffr1 vdd vss d phm phmb phs phsb rst nrst q
Xmaster (vdd vss d phm phmb rst nrst mq) sar_latchr1
Xslave (vdd vss mq phs phsb rst nrst q) sar_latchr1
ends sar_pdffr1

subckt sar_dffr1 vdd vss d clk rst q
Xri (vdd vss rst nrst) sar_inv
Xph (vdd vss clk phm phmb phs phsb) sar_phases
Xff (vdd vss d phm phmb phs phsb rst nrst q) sar_pdffr1
ends sar_dffr1

// Three-input NAND, used to select a bit slot and master phase.
subckt sar_nand3 vdd vss a b c y
Mp0 (y a vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mp1 (y b vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mp2 (y c vdd vdd) PMOS_CORE w=1e-06 l=3e-08
Mn0 (y a n0 vss) NMOS_CORE w=2e-06 l=3e-08
Mn1 (n0 b n1 vss) NMOS_CORE w=2e-06 l=3e-08
Mn2 (n1 c vss vss) NMOS_CORE w=2e-06 l=3e-08
ends sar_nand3

// Compact control: 5 Johnson DFFs, 16 static single latches.
// Direct resolved flags; v0 is permanently LOW.
// D7..D0 must be sampled after the q0 falling edge.
subckt sar_control vdd vss CLK RST cmpQ track cmpclk q0 b7 b6 b5 b4 b3 b2 b1 b0 v7 v6 v5 v4 v3 v2 v1 v0 D7 D6 D5 D4 D3 D2 D1 D0
Xreset_inv (vdd vss RST nrst) sar_inv
Xclock_phases (vdd vss CLK phm phmb phs phsb) sar_phases
Xjohnson0 (vdd vss j4b phm phmb phs phsb RST nrst j0) sar_pdffr0
Xjohnson_inv0 (vdd vss j0 j0b) sar_inv
Xjohnson1 (vdd vss j0 phm phmb phs phsb RST nrst j1) sar_pdffr0
Xjohnson_inv1 (vdd vss j1 j1b) sar_inv
Xjohnson2 (vdd vss j1 phm phmb phs phsb RST nrst j2) sar_pdffr0
Xjohnson_inv2 (vdd vss j2 j2b) sar_inv
Xjohnson3 (vdd vss j2 phm phmb phs phsb RST nrst j3) sar_pdffr0
Xjohnson_inv3 (vdd vss j3 j3b) sar_inv
Xjohnson4 (vdd vss j3 phm phmb phs phsb RST nrst j4) sar_pdffr0
Xjohnson_inv4 (vdd vss j4 j4b) sar_inv
Xq0_decode (vdd vss j0b j4b q0) sar_and2
Xtrack (vdd vss j1 j4 track) sar_nor2
Xnot_track (vdd vss track ntrack) sar_inv
Xcompare_clock (vdd vss phm ntrack cmpclk) sar_and2
Xbit_enable_n7 (vdd vss j1 j2b phm benb7) sar_nand3
Xbit_enable7 (vdd vss benb7 ben7) sar_inv
Xbit7 (vdd vss cmpQ ben7 benb7 RST nrst b7) sar_latchr0
Xbit_enable_n6 (vdd vss j2 j3b phm benb6) sar_nand3
Xbit_enable6 (vdd vss benb6 ben6) sar_inv
Xbit6 (vdd vss cmpQ ben6 benb6 RST nrst b6) sar_latchr0
Xbit_enable_n5 (vdd vss j3 j4b phm benb5) sar_nand3
Xbit_enable5 (vdd vss benb5 ben5) sar_inv
Xbit5 (vdd vss cmpQ ben5 benb5 RST nrst b5) sar_latchr0
Xbit_enable_n4 (vdd vss j0 j4 phm benb4) sar_nand3
Xbit_enable4 (vdd vss benb4 ben4) sar_inv
Xbit4 (vdd vss cmpQ ben4 benb4 RST nrst b4) sar_latchr0
Xbit_enable_n3 (vdd vss j0b j1 phm benb3) sar_nand3
Xbit_enable3 (vdd vss benb3 ben3) sar_inv
Xbit3 (vdd vss cmpQ ben3 benb3 RST nrst b3) sar_latchr0
Xbit_enable_n2 (vdd vss j1b j2 phm benb2) sar_nand3
Xbit_enable2 (vdd vss benb2 ben2) sar_inv
Xbit2 (vdd vss cmpQ ben2 benb2 RST nrst b2) sar_latchr0
Xbit_enable_n1 (vdd vss j2b j3 phm benb1) sar_nand3
Xbit_enable1 (vdd vss benb1 ben1) sar_inv
Xbit1 (vdd vss cmpQ ben1 benb1 RST nrst b1) sar_latchr0
Xbit_enable_n0 (vdd vss j3b j4 phm benb0) sar_nand3
Xbit_enable0 (vdd vss benb0 ben0) sar_inv
Xbit0 (vdd vss cmpQ ben0 benb0 RST nrst b0) sar_latchr0
Xvalid7 (vdd vss j2 j4 v7) sar_or2
Xvalid6 (vdd vss j3 j4 v6) sar_or2
Xvalid5 (vdd vss j4 v5) sar_buf_hi
Xvalid4 (vdd vss j4 j0b v4) sar_and2
Xvalid3 (vdd vss j4 j1b v3) sar_and2
Xvalid2 (vdd vss j4 j2b v2) sar_and2
Xvalid1 (vdd vss j4 j3b v1) sar_and2
Xvalid0_low (vdd vss vdd v0) sar_inv
Xoutput_enable_n (vdd vss q0 phm oenb) sar_nand2
Xoutput_enable (vdd vss oenb oen) sar_inv_hi
Xoutput7 (vdd vss b7 oen oenb RST nrst D7) sar_latchr0
Xoutput6 (vdd vss b6 oen oenb RST nrst D6) sar_latchr0
Xoutput5 (vdd vss b5 oen oenb RST nrst D5) sar_latchr0
Xoutput4 (vdd vss b4 oen oenb RST nrst D4) sar_latchr0
Xoutput3 (vdd vss b3 oen oenb RST nrst D3) sar_latchr0
Xoutput2 (vdd vss b2 oen oenb RST nrst D2) sar_latchr0
Xoutput1 (vdd vss b1 oen oenb RST nrst D1) sar_latchr0
Xoutput0 (vdd vss b0 oen oenb RST nrst D0) sar_latchr0
ends sar_control

subckt sar_comparator vdd vss clk ip in q qb
M1 (p ip tail vss) NMOS_CORE w=3e-06 l=3e-08
M2 (n in tail vss) NMOS_CORE w=3e-06 l=3e-08
M3 (x y p vss) NMOS_CORE w=1e-06 l=3e-08
